# syntax=docker/dockerfile:1

FROM python:3.11-slim AS build

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
	PYTHONUNBUFFERED=1

WORKDIR /app

COPY requirements.livekit.txt ./
RUN python -m venv .venv \
	&& .venv/bin/pip install --no-cache-dir -r requirements.livekit.txt \
	&& .venv/bin/python -m livekit.agents download-files

COPY livekit_agent.py ./
COPY conductor/__init__.py conductor/mem0_store.py ./conductor/

FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
	PATH='/app/.venv/bin:$PATH'

WORKDIR /app
COPY --from=build --chown=10001:10001 /app /app

USER 10001:10001

CMD ["python", "livekit_agent.py", "start"]
